---
interface Props {
  title: string;
  date: Date;
  excerpt: string;
  tags: string[];
  slug: string;
}

const { title, date, excerpt, tags, slug } = Astro.props;
const base = import.meta.env.BASE_URL;

const formattedDate = date.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).replace(/\//g, '.');
---

<article class="post-card">
  <div class="post-card-header">
    <h2 class="post-card-title">
      <a href={`${base}/posts/${slug}`}>{title}</a>
    </h2>
    <span class="post-card-date">{formattedDate}</span>
  </div>
  <p class="post-card-excerpt">{excerpt}</p>
  <ul class="post-card-tags">
    {tags.map((tag) => (
      <li><button class="tag" data-tag={tag}>{tag}</button></li>
    ))}
  </ul>
</article>
